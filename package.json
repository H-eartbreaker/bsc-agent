{
  "name": "bsc-agent",
  "version": "0.1.0",
  "description": "本地运行的 BSC Agent BSC 内盘行情、报价与交易终端；实盘交易默认关闭自动策略",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "watch:four": "node scripts/watch-four.js",
    "testnet:info": "node scripts/testnet-info.js",
    "live": "MODE=live node server.js",
    "live:readonly": "MODE=live LIVE_TRADE=0 NODE_USE_ENV_PROXY=1 node server.js",
    "live:8788": "MODE=live LIVE_TRADE=1 AUTO_TRANSFER_FOUR=0 PORT=8788 node server.js",
    "sim:8787": "MODE=sim PORT=8787 node server.js"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "express": "5.1.0",
    "ws": "8.22.0"
  },
  "license": "MIT"
}
