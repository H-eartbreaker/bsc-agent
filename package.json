{
  "name": "bsc-agent",
  "version": "0.3.1",
  "description": "本地运行的 BSC Agent 内盘快速买卖终端（Flap / Four / gang.fun），通过币安 Agentic Wallet（baw）下单；默认模拟盘",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "watch:four": "node scripts/watch-four.js",
    "gang:preflight": "node scripts/gang-preflight.mjs",
    "testnet:info": "node scripts/testnet-info.js",
    "live": "MODE=live node server.js",
    "live:readonly": "MODE=live LIVE_TRADE=0 NODE_USE_ENV_PROXY=1 node server.js",
    "setup": "bash install.sh"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "express": "5.1.0",
    "ws": "8.22.0"
  },
  "license": "MIT",
  "optionalDependencies": {
    "ioredis": "5.11.1",
    "mysql2": "3.24.6"
  }
}
