# 复制成 .env 后按需修改。程序启动时会自动读取项目根目录的 .env（已经在环境变量里的不覆盖）

# sim = 模拟盘；live = 实盘行情
MODE=sim
PORT=8787

# 1 = 实盘真实下单（只接受页面上手动点击的订单）；0 = 只报价 / 预演
LIVE_TRADE=0

# 单笔买入上限（BNB），0 = 不限；页面里改过后以 data/live-settings.json 为准
MAX_TRADE_BNB=0.5

# 自动转出的目标地址（领取后 / 发射后自动把代币转到这里）。务必填你自己的地址；不用自动转出就留空
AUTO_TRANSFER_TO=
# 旧开关：1 = Four 发射后自动转出（一般用页面上的开关即可）
AUTO_TRANSFER_FOUR=0

# 旧功能：买入后无限额预授权，不建议打开
PREAPPROVE=0

# 私有节点（可选，推荐）：例如 NodeReal 的 https://bsc-mainnet.nodereal.io/v1/<你的key>。填了就作为主节点（读链、查确认、扫 Four 事件，一次可查约 5 万块），
# 公共节点自动做备用。key 只放 .env，不要写进代码或提交
NODEREAL_RPC=

# 读链 RPC（不填 = 有 NODEREAL_RPC 用它，否则 bsc-dataseed）；扫 Four 事件用的 RPC；启动时回扫的区块数
RPC_URL=
FOUR_LOG_RPC=
FOUR_BACKFILL_BLOCKS=150000

# 币安 Agentic Wallet CLI
BAW_BIN=baw
BINANCE_CHAIN_ID=56
BAW_SLIPPAGE_UNIT=percent
WALLET_LABEL=币安 Agentic 钱包

# Four 专属模板的技能脚本路径（留空会自动在 .agents/ 和 ~/.claude/skills/ 里找）
OPENFOUR_SCRIPT=

# 其他可选项（一般不用改）
# 解析 .ai 域名用的 RPC，逗号分隔
NAME_RPC=
# 模拟 / 测试网用的 BSC 测试网 RPC
BSC_TESTNET_RPC=
# scripts/watch-four.js：WebSocket 节点、four.meme TokenManager 合约地址
BSC_WSS=
FOUR_MANAGER=
