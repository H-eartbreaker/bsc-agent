# 复制成 .env 后按需修改。程序启动时会自动读取项目根目录的 .env（已经在环境变量里的不覆盖）

# 默认实盘：登录币安钱包后即可真实买卖
MODE=live
PORT=8787

# 1 = 登录币安钱包后可真实下单（默认）；0 = 只看行情不下单。自动功能（狙击 / 跟单）默认关，页面上点「启动」才运行
LIVE_TRADE=1

# 单笔买入上限（BNB），0 = 不限；页面里改过后以 data/live-settings.json 为准
MAX_TRADE_BNB=0.5

# 买入成交后后台预授权：卖出合约的额度按持仓数量授权（不是无限额），卖出时不用再等授权上链
PREAPPROVE=0

# Gang V2 计价币兑换的最低公开池流动性（美元）；低于此值拒绝自动换入 / 换回，默认 20000
QUOTE_MIN_LIQ_USD=20000

# 私有节点（可选，推荐）：例如 NodeReal 的 https://bsc-mainnet.nodereal.io/v1/<你的key>。填了就作为主节点（读链、查确认、扫 Four 事件，一次可查约 5 万块），
# 公共节点自动做备用。key 只放 .env，不要写进代码或提交
NODEREAL_RPC=
# 也可以填多个 NodeReal key（逗号分隔，只填 key 本身），会轮流使用；某个被限流 / 额度用完时自动换下一个，都不可用时用公共节点
NODEREAL_KEYS=

# 读链 RPC（不填 = 有 NODEREAL_RPC 用它，否则 bsc-dataseed）；扫 Four 事件用的 RPC；启动时回扫的区块数
RPC_URL=
FOUR_LOG_RPC=
FOUR_BACKFILL_BLOCKS=150000

# 链上订阅（WebSocket）的备用节点，可填多个（逗号分隔），例如 Dwellir 免费档 wss://api-bsc-mainnet-full.n.dwellir.com/<你的key>。
# 顺序是 NodeReal → 这里 → PublicNode：NodeReal 冷却、PublicNode 限流时订阅不会断
WSS_URL=
# RPC_URL 填付费节点（如 Chainstack）时，它每分钟最多被用多少次（所有用途合计，默认 250 ≈ 每月 1000 万次），超了先用别的节点
RPC_URL_MAX_PER_MIN=250

# 币安 Agentic Wallet CLI
BAW_BIN=baw
BINANCE_CHAIN_ID=56
BAW_SLIPPAGE_UNIT=percent
WALLET_LABEL=币安 Agentic 钱包

# Four 专属模板的技能脚本路径（留空会自动在 .agents/ 和 ~/.claude/skills/ 里找）
OPENFOUR_SCRIPT=

# 其他可选项（一般不用改）
# 解析 .ai 域名用的 RPC，逗号分隔
NAME_RPC=
# 模拟 / 测试网用的 BSC 测试网 RPC
BSC_TESTNET_RPC=
# scripts/watch-four.js：WebSocket 节点、four.meme TokenManager 合约地址
BSC_WSS=
FOUR_MANAGER=

# 可选：锁定本后端对应的 BSC 钱包地址。填错时拒绝连接；不会自动退出账号。
WALLET_ADDRESS=


# 只监听本机（不要改成 0.0.0.0，也不要把端口暴露到公网）
HOST=127.0.0.1
# 示例只使用占位地址，请改为真实的该钱包地址；Token 不放入前端。
WALLET_PEERS=[]

# 本地 API 防护
# 改动类接口（下单、设置、单币规则等）只接受本页面（同源）或带 x-bsc-agent-token 的请求。
# 留空会在 data/api-token 里随机生成；多钱包时每个钱包后端要填同一个值（或在 WALLET_PEERS 里给每个钱包写 token）
BSC_AGENT_API_TOKEN=
# 额外允许的主机名 / 页面来源（逗号分隔，一般不用填）
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
# 代币头像代理额外允许的图床域名（逗号分隔；默认只允许 four.meme / pinata / gang.fun / IPFS 网关等）
IMG_HOSTS=

# 历史数据缓存（可选，不填就不启用，和以前一样）：MySQL 存各盘从开盘起的成交、外盘分钟 K 线、BNB 小时价、钱包交易记录，
# 重启或再次点开同一个币只补新的；Redis 存外部接口的短时结果，几个钱包后端共用。连不上会自动走原来的路径。
# 一键起这两个服务：docker compose -f docker/cache-compose.yml up -d
MYSQL_URL=
REDIS_URL=


# ---- 可选 ----
# 新版本提醒：默认检查官方仓库 H-eartbreaker/bsc-agent，GitHub 上有更高版本号时，右上角 GitHub 图标亮红点并弹一次提示。只提醒，不会自动更新。
# 想检查别的仓库就填「用户名/仓库名」；BSC_AGENT_UPDATE=0 关闭提醒
BSC_AGENT_UPDATE_REPO=
# 访问行情站（头像 / 池子 / K 线）的代理：一般不用填，程序会自动找；找不到就在页面「自检」里填。想手动指定才填，例如 http://127.0.0.1:7890；填 none 表示不用代理
BSC_AGENT_PROXY=
# 历史数据缓存（可选，不填就不启用）：MySQL 存成交历史，Redis 存接口短缓存。scripts/enable-cache.sh 可一键用 Docker 起
MYSQL_URL=
REDIS_URL=

# 自动转出地址不在这里配：在页面「自动转出」里设置自己的地址（改地址需二次确认）。老用户也可填 AUTO_TRANSFER_TO=0x… 作为初始值

# ---- NFT 雷达（可选）----
# 监听 Telegram 新项目频道后，页面「NFT」里可以开自动 mint（只对免费 + Agent ID 项目，只花 gas）。不用就不填。
# 1) 在 https://my.telegram.org 申请 api_id / api_hash（这是你自己的账号凭据，只放 .env，不要提交）
# 2) 运行一次  node scripts/tg-login.mjs  登录，会话保存在 data/tg-session.txt
# 3) 填要监听的频道 id（负数，如 -100xxxxxxxxxx），重启服务后会自动监听
TG_API_ID=
TG_API_HASH=
TG_CHANNEL_ID=
# 0 = 不随服务启动监听
NFT_WATCH=1
# Telegram 需要代理时填 SOCKS5 代理（Clash 的「混合端口」就支持），例如 127.0.0.1 和 7890
TG_PROXY_HOST=
TG_PROXY_PORT=
